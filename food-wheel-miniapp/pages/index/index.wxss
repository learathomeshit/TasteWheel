page{background:#dfe8d8;color:#26332a;min-height:100vh;overflow-x:hidden}
.result{position:relative}
.wheel-center{position:absolute;z-index:5;left:50%;top:50%;width:22%;aspect-ratio:1;transform:translate(-50%,-50%);display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.94);border:1rpx solid rgba(220,226,216,.95);border-radius:50%;box-shadow:0 4rpx 12rpx rgba(53,76,58,.12);color:#26332a;font-size:18rpx;font-weight:700;white-space:nowrap}
page:after{content:"";position:fixed;inset:0;z-index:-1;background:rgba(247,249,241,.28)}
.background-image{position:fixed;left:-32rpx;top:-32rpx;width:calc(100% + 64rpx);height:calc(100% + 64rpx);z-index:-2;filter:blur(18rpx);opacity:.9;transform:scale(1.06)}
.page{position:relative;z-index:1;padding:34rpx 28rpx 60rpx}
.glass{background:rgba(255,255,255,.62);border:1rpx solid rgba(255,255,255,.78);border-radius:28rpx;box-shadow:0 12rpx 36rpx rgba(53,76,58,.14);backdrop-filter:blur(20rpx)}
.glass-soft{background:rgba(255,255,255,.56);border:1rpx solid rgba(255,255,255,.7);backdrop-filter:blur(14rpx)}
.header{text-align:center;background:transparent;border:0;box-shadow:none;padding:0 0 26rpx}.tagline{display:block;color:#292929;font-size:25rpx;font-weight:600;letter-spacing:3rpx}.title{display:block;margin-top:6rpx;font-size:56rpx;font-weight:800;letter-spacing:1rpx}
.tabs{display:flex;max-width:660rpx;margin:0 auto 28rpx;padding:8rpx;gap:8rpx}.tab{flex:1;text-align:center;padding:18rpx 8rpx;border-radius:20rpx;color:#66766b;font-weight:700}.tab.active{background:#5f8667;color:#fff;box-shadow:0 8rpx 20rpx rgba(53,76,58,.16)}
.wheel-layout{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);grid-template-areas:"manager wheel";align-items:start;gap:28rpx;width:100%}.manager,.wheel-panel,.match-panel{padding:28rpx;box-sizing:border-box;min-width:0}.manager{grid-area:manager;align-self:start}.wheel-panel{grid-area:wheel;min-width:0}.section-head{display:flex;align-items:center;margin-bottom:22rpx}.section-title{font-size:34rpx;font-weight:800}
.add-grid{display:grid;grid-template-columns:minmax(0,1fr) 150rpx 88rpx;gap:12rpx}.input,.picker,.category-picker,.ingredient-input{box-sizing:border-box;width:100%;background:rgba(255,255,255,.78);border:1rpx solid rgba(255,255,255,.85);border-radius:18rpx;padding:20rpx;color:#26332a;min-height:76rpx}.picker,.category-picker{display:flex;align-items:center;padding:0 20rpx}.button{border:0;border-radius:18rpx;font-size:28rpx;font-weight:700;line-height:1.2;padding:20rpx 18rpx}.primary{background:#5f8667;color:#fff}.outline{background:rgba(255,255,255,.72);color:#45694d;border:2rpx solid #6b8f71}
.file-actions{display:grid;gap:18rpx;border-top:1rpx solid rgba(255,255,255,.8);border-bottom:1rpx solid rgba(255,255,255,.8);padding:22rpx 0;margin:22rpx 0}.dish-list{display:flex;flex-wrap:wrap;gap:12rpx}.dish-chip{display:flex;align-items:center;gap:12rpx;padding:13rpx 16rpx;background:rgba(238,243,237,.86);border:1rpx solid rgba(207,221,208,.95);border-radius:16rpx;font-size:23rpx}.remove{display:inline-flex;width:32rpx;height:32rpx;align-items:center;justify-content:center;border-radius:50%;background:#fff;color:#78857b}.hint,.empty,.result-meta,.recipe-meta{display:block;color:#66766b;font-size:22rpx;margin-top:16rpx}
.dish-search{display:flex;align-items:center;gap:16rpx;margin-top:16rpx}.dish-search .input{flex:1}.search-count{display:inline-flex;align-items:center;justify-content:center;min-width:92rpx;height:60rpx;padding:0 18rpx;box-sizing:border-box;border-radius:999rpx;background:#dceadd;border:1rpx solid #b8d0bb;color:#45694d;font-size:25rpx;font-weight:700;white-space:nowrap}.dish-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(260rpx,1fr));gap:12rpx}.edit-chip{width:auto;min-width:0;box-sizing:border-box}.edit-name{flex:1;min-width:0;width:0;color:#26332a;font-size:23rpx}.category-label{color:#66766b;font-size:21rpx;white-space:nowrap}
.import-panel{padding:20rpx;margin-top:18rpx;border-radius:18rpx}.import-input{width:100%;min-height:180rpx;background:rgba(255,255,255,.78);border-radius:16rpx;padding:18rpx;box-sizing:border-box}.import-actions{display:grid;gap:12rpx;margin-top:14rpx}
.toolbar{box-sizing:border-box;overflow:hidden;padding:20rpx;border-radius:20rpx}.toolbar-title{display:block;color:#45694d;font-size:24rpx;font-weight:800;margin-bottom:12rpx}.category-picker{width:100%;color:#45694d;font-weight:700}.wheel-wrap{position:relative;width:360px;height:360px;margin:24rpx auto;box-sizing:border-box}.wheel{position:relative;z-index:1;display:block;width:100%;height:100%}.pointer{position:absolute;z-index:10;top:-8rpx;left:50%;width:0;height:0;transform:translateX(-50%);border-left:24rpx solid transparent;border-right:24rpx solid transparent;border-top:44rpx solid #df705d;filter:drop-shadow(0 4rpx 5rpx rgba(53,76,58,.22))}.spin{width:100%;background:#5f8667;color:#fff;box-shadow:0 10rpx 22rpx rgba(53,76,58,.18)}
.result{min-height:150rpx;margin-top:20rpx;padding:24rpx;text-align:center;border-radius:22rpx;display:flex;flex-direction:column;align-items:center;justify-content:center}.result-name{font-size:46rpx;font-weight:800;color:#df705d}.preview-title{font-size:30rpx;font-weight:800;margin:26rpx 0 14rpx}.groups{display:grid;gap:14rpx}.dish-group{overflow:hidden;border:1rpx solid rgba(255,255,255,.8);border-radius:20rpx;background:rgba(255,255,255,.5)}.group-head{display:flex;justify-content:space-between;padding:22rpx;background:rgba(238,243,237,.8);font-weight:800;font-size:27rpx}.group-meta{color:#66766b;font-size:22rpx;font-weight:600}.group-body{display:grid;grid-template-columns:repeat(auto-fit,minmax(190rpx,1fr));gap:10rpx;padding:16rpx}.preview-item{display:flex;align-items:center;gap:8rpx;padding:14rpx;background:rgba(245,248,244,.82);border:1rpx solid rgba(255,255,255,.8);border-radius:14rpx;font-size:23rpx}.number{background:#dceadd;color:#45694d;border-radius:8rpx;padding:3rpx 8rpx;font-weight:700}
.spin-emoji{display:block;height:58rpx;margin-bottom:8rpx;font-size:48rpx;line-height:58rpx;animation:emojiWobble .36s ease-in-out infinite}.drawing-title{font-size:30rpx;font-weight:800;color:#45694d;animation:drawingPulse 1.15s ease-in-out infinite}.loading-dots{display:flex;gap:10rpx;margin-top:14rpx}.loading-dots text{display:block;width:12rpx;height:12rpx;border-radius:50%;background:#6b9171;animation:dotBounce 1s ease-in-out infinite}.loading-dots text:nth-child(2){animation-delay:.16s}.loading-dots text:nth-child(3){animation-delay:.32s}.result-finished{animation:resultFlip 1.05s cubic-bezier(.2,.8,.2,1) both;box-shadow:0 0 0 0 rgba(95,134,103,0);transform-style:preserve-3d}.result-finished .result-name{animation:resultNamePop .6s ease-out both}
@keyframes drawingPulse{0%,100%{opacity:.55;transform:scale(.98)}50%{opacity:1;transform:scale(1.02)}}@keyframes emojiWobble{0%,100%{transform:scale(.96) rotate(-3deg)}50%{transform:scale(1.05) rotate(3deg)}}@keyframes dotBounce{0%,60%,100%{transform:translateY(0);opacity:.45}30%{transform:translateY(-9rpx);opacity:1}}@keyframes resultFlip{0%{opacity:.7;transform:perspective(700px) rotateY(0deg);box-shadow:0 0 0 14rpx rgba(95,134,103,.12)}45%{opacity:1;transform:perspective(700px) rotateY(105deg);box-shadow:0 8rpx 22rpx rgba(53,76,58,.2)}78%{transform:perspective(700px) rotateY(360deg);box-shadow:0 5rpx 16rpx rgba(53,76,58,.16)}85%{transform:perspective(700px) rotateY(367deg)}91%{transform:perspective(700px) rotateY(354deg)}96%{transform:perspective(700px) rotateY(363deg)}100%{opacity:1;transform:perspective(700px) rotateY(360deg);box-shadow:0 0 0 0 rgba(95,134,103,0)}}@keyframes resultNamePop{0%{opacity:0;transform:scale(.75)}70%{transform:scale(1.08)}100%{opacity:1;transform:scale(1)}}
.match-panel{display:grid;gap:20rpx}.ingredient-input{width:100%;min-height:190rpx}.chips{display:flex;flex-wrap:wrap;gap:10rpx}.chip{padding:10rpx 16rpx;border-radius:999rpx;background:rgba(238,243,237,.86);color:#45694d;font-size:23rpx}.recipe{display:flex;flex-direction:column;padding:22rpx;border-radius:20rpx}.recipe-name{font-size:30rpx;font-weight:800}.notice{padding:20rpx;border-radius:18rpx;background:rgba(247,240,223,.8);color:#66766b;font-size:23rpx}
@media(max-width:800px){.wheel-layout{display:flex;flex-direction:column;gap:24rpx}.wheel-panel,.manager{width:100%;box-sizing:border-box}.wheel-panel{order:1;margin-top:0}.manager{order:2}}@media(max-width:560px){.page{padding-left:20rpx;padding-right:20rpx}.title{font-size:48rpx}.add-grid{grid-template-columns:1fr}.group-body{grid-template-columns:1fr}.wheel-panel{padding:20rpx}.wheel-wrap{width:300px;height:300px;margin-top:18rpx;margin-bottom:18rpx}.toolbar{padding:16rpx}.toolbar-title{font-size:22rpx}.category-picker{font-size:25rpx}}

